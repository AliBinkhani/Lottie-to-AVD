{
  "name": "Lottie to AnimatedVectorDrawable",
  "short_name": "Lottie → AVD",
  "description": "Convert Lottie JSON animations to Android AnimatedVectorDrawable XML in the browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0E1216",
  "theme_color": "#1B7F5A",
  "icons": [
    { "src": "assets/icons/favicon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "assets/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
